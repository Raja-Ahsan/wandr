{
    "name": "livelyworks/loveria",
    "type": "project",
    "description": "Loveria / Wandr dating platform",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "aws/aws-sdk-php": "^3.378",
        "barryvdh/laravel-dompdf": "^3.0",
        "box/spout": "^3.3",
        "firebase/php-jwt": "^6.0",
        "gettext/gettext": "^5.7",
        "gettext/languages": "^2.10",
        "gettext/php-scanner": "^2.0",
        "imdhemy/laravel-purchases": "^1.17",
        "intervention/image": "^2.7",
        "laracasts/utilities": "^3.2",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.7",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^2.10",
        "livelyworks/laraware": "^1.2",
        "livelyworks/laravel-yes-authority": "^2.9",
        "pusher/pusher-php-server": "^7.2",
        "razorpay/razorpay": "^2.9",
        "seven.io/api": "^4.0",
        "sms77/api": "^2.0",
        "stripe/stripe-php": "^14.10",
        "twilio/sdk": "^8.0",
        "unn/gettext-blade": "dev-main",
        "vemcogroup/laravel-sparkpost-driver": "^5.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Yantrana/Support/php-gettext-1.0.12/gettext.inc",
            "app-boot-helper.php",
            "app/Yantrana/Support/translation-helpers.php",
            "app/Yantrana/Support/Agora/RtmTokenBuilder.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
